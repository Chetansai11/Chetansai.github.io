{
  "name": "website-ps",
  "version": "1.0.0",
  "description": "Portfolio website redesign using Tailwind CSS v4",
  "main": "index.html",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./assets/css/main.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./assets/css/main.css --minify"
